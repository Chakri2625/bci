# Server Settings
PORT=3000

# Emotiv Cortex API Settings (from https://account.emotiv.com/my-account/cortex-apps/)
CORTEX_URL=wss://localhost:6868
CORTEX_CLIENT_ID=your_cortex_client_id_here
CORTEX_CLIENT_SECRET=your_cortex_client_secret_here
CORTEX_LICENSE=
CORTEX_DEBIT=1

# BCI State Machine Tuning
POWER_THRESHOLD=0.35
DEBOUNCE_MS=900
SINGLE_FIRE_WINDOW_MS=1500
COMBO_WINDOW_MS=2000
FRAMING_WINDOW_MS=4000
FRAMING_ENABLED=true
AUTO_RETURN_TIMEOUT_MS=0

# ESP32 Hardware Connection
ESP32_MODE=serial
ESP32_SERIAL_PORT=COM5
ESP32_BAUD_RATE=115200
ESP32_IP=192.168.1.100
ESP32_PORT=80
